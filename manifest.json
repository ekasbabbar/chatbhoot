{
    "manifest_version": 3,
    "name": "ChatBhoot",
    "version": "0.3.0",
    "description": "Inline predictive typing powered by the user's OpenAI API key (encrypted client-side).",
    "icons": {
      "16": "icons/16.png"
    },
    "permissions": ["storage", "scripting"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "src/service_worker.js"
    },
    "action": {
      "default_popup": "src/popup.html",
      "default_icon": "icons/128.png"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["src/content.js"],
        "run_at": "document_idle"
      }
    ],
    "options_ui": {
      "page": "src/options.html",
      "open_in_tab": true
    }
  }
  